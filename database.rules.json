{
  "rules": {
    ".read": false,
    ".write": false,
    "v2": { ".read": false, ".write": false },
    "v3": {
      "rooms": {
        ".indexOn": ["expiresAt"],
        "$roomId": {
          ".read": "auth != null && root.child('v3/members').child($roomId).child(auth.uid).exists() && data.child('expiresAt').val() > now",
          ".write": false
        }
      },
      "players": {
        "$roomId": {
          ".read": "auth != null && root.child('v3/members').child($roomId).child(auth.uid).exists() && root.child('v3/rooms').child($roomId).child('expiresAt').val() > now",
          ".write": false
        }
      },
      "members": {
        "$roomId": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid && root.child('v3/rooms').child($roomId).child('expiresAt').val() > now",
            ".write": false
          }
        }
      },
      "history": {
        "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false }
      },
      "privateRooms": { ".read": false, ".write": false },
      "answers": { ".read": false, ".write": false },
      "codes": { ".read": false, ".write": false },
      "rateLimits": { ".read": false, ".write": false }
    }
  }
}
